  # Create address segments
  assign_bd_address -offset 0x04000000 -range 0x04000000 -target_address_space [get_bd_addr_spaces microblaze_riscv_0/Data] [get_bd_addr_segs axi4_hyperram_0/s00_axi/reg0] -force
