# Explicit SCU35 pin mapping; no board-store dependency.
# MII/MDIO pins checked against the SCU35 v1.2 part0_pins.xml.
set_property PACKAGE_PIN F23 [get_ports sysclk_p]
set_property PACKAGE_PIN E23 [get_ports sysclk_n]
set_property IOSTANDARD LVDS [get_ports {sysclk_p sysclk_n}]
set_property PACKAGE_PIN F3 [get_ports reset_n]
set_property IOSTANDARD LVCMOS33 [get_ports reset_n]
set_property PULLUP TRUE [get_ports reset_n]
set_property PACKAGE_PIN AC6 [get_ports uartb_rxd]
set_property PACKAGE_PIN AB6 [get_ports uartb_txd]
set_property IOSTANDARD LVCMOS33 [get_ports {uartb_rxd uartb_txd}]
set_property PACKAGE_PIN AD7 [get_ports {mii_rxd[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {mii_rxd[0]}]
set_property PACKAGE_PIN AE5 [get_ports {mii_rxd[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {mii_rxd[1]}]
set_property PACKAGE_PIN AE6 [get_ports {mii_rxd[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {mii_rxd[2]}]
set_property PACKAGE_PIN AE7 [get_ports {mii_rxd[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {mii_rxd[3]}]
set_property PACKAGE_PIN AB7 [get_ports {mii_txd[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {mii_txd[0]}]
set_property PACKAGE_PIN AC7 [get_ports {mii_txd[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {mii_txd[1]}]
set_property PACKAGE_PIN W9 [get_ports {mii_txd[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {mii_txd[2]}]
set_property PACKAGE_PIN Y9 [get_ports {mii_txd[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {mii_txd[3]}]
set_property PACKAGE_PIN AC9 [get_ports {mii_tx_clk}]
set_property IOSTANDARD LVCMOS33 [get_ports {mii_tx_clk}]
set_property PACKAGE_PIN AD9 [get_ports {mii_tx_en}]
set_property IOSTANDARD LVCMOS33 [get_ports {mii_tx_en}]
set_property PACKAGE_PIN AE11 [get_ports {mii_rx_dv}]
set_property IOSTANDARD LVCMOS33 [get_ports {mii_rx_dv}]
set_property PACKAGE_PIN AE8 [get_ports {mii_rx_er}]
set_property IOSTANDARD LVCMOS33 [get_ports {mii_rx_er}]
set_property PACKAGE_PIN AE12 [get_ports {mii_rx_clk}]
set_property IOSTANDARD LVCMOS33 [get_ports {mii_rx_clk}]
set_property PACKAGE_PIN AE10 [get_ports {mii_col}]
set_property IOSTANDARD LVCMOS33 [get_ports {mii_col}]
set_property PACKAGE_PIN AD6 [get_ports {mii_crs}]
set_property IOSTANDARD LVCMOS33 [get_ports {mii_crs}]
set_property PACKAGE_PIN AB9 [get_ports {mdio_mdc}]
set_property IOSTANDARD LVCMOS33 [get_ports {mdio_mdc}]
set_property PACKAGE_PIN AA9 [get_ports {mdio_mdio_io}]
set_property IOSTANDARD LVCMOS33 [get_ports {mdio_mdio_io}]
set_property PACKAGE_PIN AE9 [get_ports {phy_reset_n}]
set_property IOSTANDARD LVCMOS33 [get_ports {phy_reset_n}]
set_property SLEW SLOW [get_ports {mii_txd[*] mii_tx_en mdio_mdc phy_reset_n}]
set_property DRIVE 8 [get_ports {mii_txd[*] mii_tx_en mdio_mdc phy_reset_n}]
# DP83867IR datasheet SNLS484J, sections 6.12/6.13, 100 Mbps MII.
# Add 1 ns conservative relative PCB skew to PHY RX delay / TX setup/hold.
# Board trace skew is not independently characterized by this project.
set_input_delay -clock [get_clocks mii_rx_clk] -min 9.0 [get_ports {mii_rxd[*] mii_rx_dv mii_rx_er}]
set_input_delay -clock [get_clocks mii_rx_clk] -max 31.0 [get_ports {mii_rxd[*] mii_rx_dv mii_rx_er}]
set_output_delay -clock [get_clocks mii_tx_clk] -max 11.0 [get_ports {mii_txd[*] mii_tx_en}]
set_output_delay -clock [get_clocks mii_tx_clk] -min -1.0 [get_ports {mii_txd[*] mii_tx_en}]
# Carrier/collision are asynchronous link status inputs, not packet data.
set_false_path -from [get_ports {mii_col mii_crs reset_n uartb_rxd}]
# UART TX, PHY reset and management are slow control paths.
set_false_path -to [get_ports {uartb_txd phy_reset_n mdio_mdc mdio_mdio_io}]
set_false_path -from [get_ports mdio_mdio_io]
# BD interface metadata and Clocking Wizard supply primary clocks:
# sysclk_p = 10 ns; mii_rx_clk and mii_tx_clk = 40 ns. No duplicate clocks.
# The vendor MAC handles CDC between the unrelated fabric and PHY clocks.
set_clock_groups -asynchronous -group [get_clocks -include_generated_clocks sysclk_p] -group [get_clocks mii_rx_clk] -group [get_clocks mii_tx_clk]
